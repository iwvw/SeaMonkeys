<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="SeaMonkeys.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:SeaMonkeys.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:ShipTypeIconConverter x:Key="ShipTypeIcon" />
            <local:BattleTypeIconConverter x:Key="BattleTypeIcon" />

            <!-- pill 底色：用户名（强调色）与公会名（中性填充），随主题自适应 -->
            <StaticResource x:Key="NamePillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="ClanPillBrush" ResourceKey="ControlFillColorSecondaryBrush" />

            <!-- 页面内容最大宽度：对齐 Windows 设置的限宽居中范式 -->
            <x:Double x:Key="PageContentMaxWidth">1064</x:Double>

            <!-- 内容区透出背景材质：覆盖 NavigationView 默认的半透明灰层 -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

            <!-- 去掉导航页内的分隔线 -->
            <SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <!-- 详细浮窗：不用亚克力/Mica，改为不透明底色 -->
            <Style x:Key="OpaqueFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
            </Style>

            <!-- 卡片容器用 Grid：单 visual，圆角平滑无接缝 -->
            <Style x:Key="CardStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PageRootStyle" TargetType="Page">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- 首页导航卡片：整卡可点击跳转 -->
            <Style x:Key="DashboardCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
