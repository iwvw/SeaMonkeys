<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeaMonkeys.App.Pages.RenderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SeaMonkeys.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,0,24,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Margin="0,24,0,0"
                             Title="回放渲染"
                             Subtitle="{x:Bind StatusText, Mode=OneWay}" />

        <Grid Grid.Row="1" ColumnSpacing="16" Padding="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 参数面板 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Padding="0,0,4,0">
                    <Grid Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="对局来源" />
                            <ComboBox x:Name="HistoryBox" HorizontalAlignment="Stretch"
                                      PlaceholderText="选择历史对局" SelectionChanged="History_Changed" />
                            <Button Content="导入回放文件…" HorizontalAlignment="Stretch" Click="ImportReplay_Click" />
                            <TextBlock x:Name="SourceText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" Text="未选择对局" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="输出参数" />
                            <ComboBox x:Name="CodecBox" Header="编码器" HorizontalAlignment="Stretch"
                                      SelectionChanged="Codec_Changed">
                                <ComboBoxItem Content="自动（GPU 优先）" />
                                <ComboBoxItem Content="H.264" />
                                <ComboBoxItem Content="H.265" />
                            </ComboBox>
                            <NumberBox x:Name="MaxSizeBox" Header="目标体积上限 (MiB，0 为不限)"
                                       HorizontalAlignment="Stretch"
                                       Minimum="0" Maximum="4096" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MaxSize_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="显示元素" Margin="0,0,0,6" />
                            <Grid ColumnSpacing="12" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ToggleSwitch Grid.Row="0" Grid.Column="0" x:Name="PlayerNamesSwitch" Header="玩家名" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="0" Grid.Column="1" x:Name="CapturePointsSwitch" Header="占点区域" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="1" Grid.Column="0" x:Name="BuildingsSwitch" Header="建筑标记" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="CameraSwitch" Header="相机方向" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="2" Grid.Column="0" x:Name="ArmamentSwitch" Header="武器/弹药" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="2" Grid.Column="1" x:Name="KillFeedSwitch" Header="击杀信息" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="3" Grid.Column="0" x:Name="SpeedTrailsSwitch" Header="航速轨迹" Toggled="Toggle_Changed" />
                                <ToggleSwitch Grid.Row="3" Grid.Column="1" x:Name="ShipConfigSwitch" Header="射程/点亮圈" Toggled="Toggle_Changed" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="渲染工具" />
                            <TextBlock x:Name="ToolStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" Text="检测中…" />
                            <Button x:Name="DownloadToolButton" Content="下载渲染工具"
                                    HorizontalAlignment="Stretch" Click="DownloadTool_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 预览与成果 -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PreviewButton" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Preview_Click" ToolTipService.ToolTip="渲染中间一帧作为预览">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE7B3;" />
                            <TextBlock FontSize="14" Text="预览单帧" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RenderButton" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Render_Click" ToolTipService.ToolTip="渲染完整视频">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE714;" />
                            <TextBlock FontSize="14" Text="渲染视频" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Cancel_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                            <TextBlock FontSize="14" Text="取消" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Padding="12" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <TextBlock x:Name="PreviewPlaceholder"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="预览将显示在这里" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="8">
                    <ProgressBar x:Name="RenderProgressBar" Minimum="0" Maximum="1" Value="0"
                                 HorizontalAlignment="Stretch" Visibility="Collapsed" />
                    <TextBlock x:Name="RenderStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ResultPanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Name="ResultText" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Content="打开视频" Click="OpenResult_Click" />
                        <Button Content="打开所在文件夹" Click="OpenResultFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
