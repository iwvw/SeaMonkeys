<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SeaMonkeys.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:SeaMonkeys.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    </Page.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:PageHeader Grid.Row="0" MaxWidth="1064" Margin="36,24,36,0"
                          Title="应用设置"
                          Subtitle="游戏路径、战绩源与显示偏好" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Padding="36,0,36,0">
            <Border>
                <StackPanel Padding="0,0,0,24" MaxWidth="{StaticResource PageContentMaxWidth}"
                            Spacing="{StaticResource SettingsCardSpacing}">
                    <StackPanel.ChildrenTransitions>
                        <EntranceThemeTransition FromVerticalOffset="50" />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </StackPanel.ChildrenTransitions>

                    <controls:SettingsExpander Header="常规">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE713;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="《战舰世界》安装目录，留空则自动检测" Header="游戏路径">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="GamePathBox" Width="360"
                                             PlaceholderText="例如 D:\Game\World of Warships"
                                             TextChanged="GamePath_Changed" />
                                    <Button Content="自动检测" Click="DetectGamePath_Click" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="自动会读取区域日志，失败时跨区探测" Header="服务器">
                                <ComboBox x:Name="ServerBox" Width="160" SelectionChanged="Server_Changed">
                                    <ComboBoxItem Content="自动" />
                                    <ComboBoxItem Content="亚服" />
                                    <ComboBoxItem Content="欧服" />
                                    <ComboBoxItem Content="美服" />
                                    <ComboBoxItem Content="莱服" />
                                    <ComboBoxItem Content="国服" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="监视 replay 目录，出现新对局时自动加载" Header="对局观察">
                                <ToggleSwitch x:Name="ObserveSwitch" Toggled="Observe_Toggled" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="战绩源与代理">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE968;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="留空则直连各区域接口；填写后所有请求经该地址转发" Header="代理地址">
                                <TextBox x:Name="ProxyBox" Width="360"
                                         PlaceholderText="例如 https://proxy.example.com"
                                         TextChanged="Proxy_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="每个请求之间的间隔，用于避免触发限流" Header="请求间隔 (ms)">
                                <TextBox x:Name="DelayBox" Width="120" TextChanged="Delay_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="同一时间并发发起的请求数上限，越大越快" Header="并发上限">
                                <TextBox x:Name="ParallelBox" Width="120" TextChanged="Parallel_Changed" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="舰船目录">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7B8;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard x:Name="CatalogVersionCard" Description="本地船名表版本" Header="当前版本">
                                <TextBlock x:Name="CatalogVersionText" VerticalAlignment="Center" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="留空则不更新；填写后可静默下载新船名表" Header="更新地址">
                                <TextBox x:Name="CatalogUrlBox" Width="360"
                                         PlaceholderText="例如 https://example.com/ships.json"
                                         TextChanged="CatalogUrl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Name="CatalogUpdateCard"
                                                   Description="立即从更新地址下载最新船名表" Header="立即更新">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="CatalogStatusText" VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="320"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="CatalogUpdateButton" Content="更新" Click="UpdateCatalog_Click" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="从本地游戏数据生成，官方译名且覆盖最全（需已安装游戏）"
                                                   Header="从本地游戏生成">
                                <Button x:Name="CatalogGenerateButton" Content="生成" Click="GenerateCatalog_Click" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="回放渲染">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE786;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="GitHub 下载加速前缀，留空则直连 github.com" Header="下载加速">
                                <TextBox x:Name="AcceleratorBox" Width="360"
                                         PlaceholderText="例如 https://ghfast.top/"
                                         TextChanged="Accelerator_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="minimap_renderer.exe 的路径，留空则使用内置下载目录" Header="渲染工具路径">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="RendererPathBox" Width="360"
                                             PlaceholderText="例如 C:\tools\minimap_renderer.exe"
                                             TextChanged="RendererPath_Changed" />
                                    <Button Content="选择…" Click="PickRenderer_Click" />
                                </StackPanel>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="显示">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="导航栏位置，切换后立即生效" Header="导航样式">
                                <ComboBox x:Name="NavStyleBox" Width="160"
                                          SelectionChanged="NavStyle_SelectionChanged">
                                    <ComboBoxItem Content="左侧" />
                                    <ComboBoxItem Content="顶部" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="窗口背景材质，切换后立即生效" Header="背景材质">
                                <ComboBox x:Name="BackdropStyleBox" Width="160"
                                          SelectionChanged="BackdropStyle_SelectionChanged">
                                    <ComboBoxItem Content="亚克力" />
                                    <ComboBoxItem Content="Mica" />
                                    <ComboBoxItem Content="纯色" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="玩家胜率色条配色，切换后立即生效" Header="配色风格">
                                <ComboBox x:Name="ColorStyleBox" Width="160"
                                          SelectionChanged="ColorStyle_SelectionChanged">
                                    <ComboBoxItem Content="无颜色" />
                                    <ComboBoxItem Content="4 色" />
                                    <ComboBoxItem Content="分类色" />
                                    <ComboBoxItem Content="彩虹" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Description="对局列表排序维度（始终按舰种分组）" Header="排序">
                                <ComboBox x:Name="SortBox" Width="160" SelectionChanged="Sort_Changed">
                                    <ComboBoxItem Content="加权胜率" />
                                    <ComboBoxItem Content="账号胜率" />
                                    <ComboBoxItem Content="场次" />
                                </ComboBox>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="观察名单">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE734;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Description="命中观察名单的玩家在战场页高亮显示" Header="高亮标记玩家">
                                <ToggleSwitch x:Name="HighlightSwitch" Toggled="Highlight_Toggled" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="关于">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="SeaMonkeys" Description="《战舰世界》实时战绩助手">
                                <TextBlock x:Name="AboutVersionText" Text="v-" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="项目主页" Description="GitHub 仓库，欢迎反馈问题与建议">
                                <HyperlinkButton x:Name="RepoLink"
                                                 Content="iwvw/SeaMonkeys"
                                                 NavigateUri="https://github.com/iwvw/SeaMonkeys" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="开发者" Description="DSUK">
                                <HyperlinkButton x:Name="AuthorLink"
                                                 Content="GitHub @iwvw"
                                                 NavigateUri="https://github.com/iwvw" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="开源许可" Description="MIT License · Copyright (c) 2026 DSUK">
                                <HyperlinkButton Content="查看 LICENSE"
                                                 NavigateUri="https://github.com/iwvw/SeaMonkeys/blob/main/LICENSE" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsExpander Header="使用的开源项目">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE943;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="Windows App SDK" Description="WinUI 3 界面框架（MIT）">
                                <HyperlinkButton Content="microsoft/WindowsAppSDK"
                                                 NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="CommunityToolkit.WinUI" Description="设置卡片与转换器控件（MIT）">
                                <HyperlinkButton Content="CommunityToolkit/Windows"
                                                 NavigateUri="https://github.com/CommunityToolkit/Windows" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="wows-toolkit" Description="回放渲染与游戏数据解包工具（MIT）">
                                <HyperlinkButton Content="landaire/wows-toolkit"
                                                 NavigateUri="https://github.com/landaire/wows-toolkit" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Header="ApeRadar" Description="分级算法与输出文本格式参考">
                                <HyperlinkButton Content="iwvw-per/ApeRadar"
                                                 NavigateUri="https://github.com/iwvw-per/ApeRadar" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
